/**
 * Group Signup — Google Apps Script backend (one deployment per course)
 *
 * Deployed as a Web App ("Execute as: Me", "Who has access: Anyone").
 * The static site on GitHub Pages talks to this script. The script is the
 * only thing that can read or write the Google Sheet, so the Sheet stays
 * private to the instructor even though the site is public.
 *
 * Sheets in the course workbook (created by setup()):
 *   Course       — key | value   (COURSE_NAME, COURSE_CODE, YEAR, TERM, SECTION, PROFESSOR)
 *   Settings     — key | value   (ADMIN_KEY, SIGNUP_OPEN, NAME_DISPLAY, OPEN_ENROLLMENT, SELF_SERVICE_LINKS, SITE_URL)
 *   Assignments  — id | name | due | signup_closes | open | instructions
 *   <one tab per assignment, named by its id> — id | name | slots | description
 *   Roster       — email | name | token | created | invite_link
 *   Signups      — email | assignment | group_id | updated
 *   Log          — timestamp | email | assignment | action | group_id | detail
 *
 * Instructor-only functions (run from the Apps Script editor):
 *   setup()                create the sheets with headers and sample rows
 *   addAssignmentSheets()  create a groups tab for every Assignments row that lacks one
 *   generateTokens()       fill in a token for every Roster row that lacks one
 *   writeInviteLinks()     fill the invite_link column from SITE_URL + token
 *   sendInvites()          email each student their personal link (optional; students can
 *                          also request their own link from the site when SELF_SERVICE_LINKS is true)
 *   backupToDropbox()      copy a CSV snapshot to Dropbox (optional)
 */

var SHEETS = {
  COURSE:      'Course',
  SETTINGS:    'Settings',
  ASSIGNMENTS: 'Assignments',
  ROSTER:      'Roster',
  SIGNUPS:     'Signups',
  LOG:         'Log'
};

var RESERVED_SHEET_NAMES = Object.keys(SHEETS).map(function (k) { return SHEETS[k]; });

var DEFAULT_COURSE = {
  COURSE_NAME: 'Politics of Immigration and Citizenship',
  COURSE_CODE: 'POL 3540',
  YEAR:        '2026',
  TERM:        'Fall',
  SECTION:     '001',
  PROFESSOR:   'Zack Taylor'
};

var DEFAULT_SETTINGS = {
  ADMIN_KEY:       '',            // generated by setup(); used by the instructor panel to export data
  SIGNUP_OPEN:     'true',        // "false" freezes every assignment at once
  NAME_DISPLAY:    'initial',     // "full" => "Ada Lovelace"; "initial" => "Ada L."
  OPEN_ENROLLMENT: 'false',       // "true" lets students not on the Roster register themselves
  SELF_SERVICE_LINKS: 'true',     // "true" lets students pick their name and get their link emailed to them
  SITE_URL:        ''             // e.g. https://yourname.github.io/group-signup/?c=abc1000
};

var LINK_REQUESTS_PER_DAY = 5;    // per student, to stop the public page being used to spam an inbox
var LINK_REQUEST_COOLDOWN_MS = 60 * 1000;

var ASSIGNMENT_HEADERS = ['id', 'name', 'due', 'signup_closes', 'open', 'instructions'];
var GROUP_HEADERS = ['id', 'name', 'slots', 'description'];

// ---------------------------------------------------------------------------
// HTTP entry points
// ---------------------------------------------------------------------------

function doGet(e) {
  var params = (e && e.parameter) || {};
  if (!params.action) {
    return jsonResponse({ ok: true, service: 'group-signup', hint: 'POST a JSON body with an action.' });
  }
  return jsonResponse(handleRequest(params));
}

function doPost(e) {
  var req = {};
  try {
    req = JSON.parse((e && e.postData && e.postData.contents) || '{}');
  } catch (err) {
    return jsonResponse({ ok: false, error: 'Request body was not valid JSON.' });
  }
  return jsonResponse(handleRequest(req));
}

function jsonResponse(obj) {
  return ContentService
    .createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}

function handleRequest(req) {
  try {
    switch (req.action) {
      case 'state':    return actionState(req);
      case 'roster':   return actionRoster(req);
      case 'sendLink': return withLock(function () { return actionSendLink(req); });
      case 'resetToken': return withLock(function () { return actionResetToken(req); });
      case 'register': return withLock(function () { return actionRegister(req); });
      case 'join':     return withLock(function () { return actionJoin(req); });
      case 'leave':    return withLock(function () { return actionLeave(req); });
      case 'export':   return actionExport(req);
      default:         return { ok: false, error: 'Unknown action.' };
    }
  } catch (err) {
    return { ok: false, error: String(err && err.message || err) };
  }
}

function withLock(fn) {
  var lock = LockService.getScriptLock();
  lock.waitLock(15000);
  try {
    return fn();
  } finally {
    lock.releaseLock();
  }
}

// ---------------------------------------------------------------------------
// Actions
// ---------------------------------------------------------------------------

function actionState(req) {
  var db = loadDb();
  var me = req.token ? findByToken(db, req.token) : null;
  return publicState(db, me);
}

function actionRegister(req) {
  var db = loadDb();
  if (!isTrue(db.settings.OPEN_ENROLLMENT)) {
    return { ok: false, error: 'Self-registration is off. Use the personal link your instructor sent you.' };
  }
  var email = normalizeEmail(req.email);
  var name = String(req.name || '').trim();
  if (!email || email.indexOf('@') < 1) return { ok: false, error: 'Please enter a valid email address.' };
  if (!name) return { ok: false, error: 'Please enter your name.' };

  var existing = db.roster.filter(function (r) { return r.email === email; })[0];
  if (existing) {
    return { ok: false, error: 'That email is already registered. Use your personal link, or ask the instructor to resend it.' };
  }

  var token = newToken();
  getSheet(SHEETS.ROSTER).appendRow([email, name, token, new Date(), '']);
  appendLog(email, '', 'register', '', name);

  db = loadDb();
  var out = publicState(db, findByToken(db, token));
  out.token = token;
  return out;
}

/** Names on the roster with opaque ids, so a student can find themselves. Never includes emails or tokens. */
function actionRoster(req) {
  var db = loadDb();
  if (!isTrue(db.settings.SELF_SERVICE_LINKS)) return { ok: false, error: 'Self-service links are turned off for this course.' };
  var roster = db.roster.map(function (r) { return { id: rosterId(r.email), name: r.name }; });
  roster.sort(function (a, b) { return a.name.localeCompare(b.name); });
  return { ok: true, roster: roster };
}

/** Email a student their personal link, to the address the instructor has on file. */
function actionSendLink(req) {
  var db = loadDb();
  if (!isTrue(db.settings.SELF_SERVICE_LINKS)) return { ok: false, error: 'Self-service links are turned off for this course.' };
  if (!String(db.settings.SITE_URL || '').trim()) return { ok: false, error: 'The instructor has not set SITE_URL yet, so links cannot be emailed.' };

  var id = String(req.rosterId || '').trim();
  var entry = db.roster.filter(function (r) { return rosterId(r.email) === id; })[0];
  if (!entry) return { ok: false, error: 'That name is not on the roster.' };

  var limited = linkRequestLimit(entry.email);
  if (limited) return { ok: false, error: limited };
  if (MailApp.getRemainingDailyQuota() < 1) {
    return { ok: false, error: 'The email limit for today has been reached. Ask the instructor to send your link.' };
  }

  if (!entry.token) {
    entry.token = newToken();
    getSheet(SHEETS.ROSTER).getRange(entry.row, 3).setValue(entry.token);
  }
  sendLinkEmail(db, entry);
  appendLog(entry.email, '', 'sendlink', '', '');
  return { ok: true, sentTo: maskEmail(entry.email) };
}

/** A signed-in student replaces their token (old links stop working) and gets the new link by email. */
function actionResetToken(req) {
  var db = loadDb();
  var me = findByToken(db, req.token);
  if (!me) return { ok: false, error: 'Your link is not recognised. Ask the instructor for a new one.' };
  if (!String(db.settings.SITE_URL || '').trim()) return { ok: false, error: 'The instructor has not set SITE_URL yet, so links cannot be emailed.' };
  if (MailApp.getRemainingDailyQuota() < 1) {
    return { ok: false, error: 'The email limit for today has been reached. Try again tomorrow or ask the instructor.' };
  }

  me.token = newToken();
  getSheet(SHEETS.ROSTER).getRange(me.row, 3).setValue(me.token);
  sendLinkEmail(db, me);
  appendLog(me.email, '', 'reset', '', '');
  return { ok: true, sentTo: maskEmail(me.email) };
}

function actionJoin(req) {
  var db = loadDb();
  var me = findByToken(db, req.token);
  if (!me) return { ok: false, error: 'Your link is not recognised. Ask the instructor for a new one.' };

  var assignment = findAssignment(db, req.assignmentId);
  if (!assignment) return { ok: false, error: 'That assignment does not exist.' };

  var closed = closedReason(db.settings, assignment);
  if (closed) return { ok: false, error: closed };

  var groupId = String(req.groupId || '').trim();
  var group = assignment.groups.filter(function (g) { return g.id === groupId; })[0];
  if (!group) return { ok: false, error: 'That group does not exist.' };

  var current = findSignup(db, me.email, assignment.id);
  if (current && current.groupId === groupId) return publicState(db, me);

  var filled = db.signups.filter(function (s) { return s.assignment === assignment.id && s.groupId === groupId; }).length;
  if (group.slots > 0 && filled >= group.slots) {
    return { ok: false, error: 'Sorry, "' + group.name + '" is full.' };
  }

  upsertSignup(me.email, assignment.id, groupId);
  appendLog(me.email, assignment.id, current ? 'switch' : 'join', groupId, current ? 'from ' + current.groupId : '');

  return publicState(loadDb(), me);
}

function actionLeave(req) {
  var db = loadDb();
  var me = findByToken(db, req.token);
  if (!me) return { ok: false, error: 'Your link is not recognised. Ask the instructor for a new one.' };

  var assignment = findAssignment(db, req.assignmentId);
  if (!assignment) return { ok: false, error: 'That assignment does not exist.' };

  var closed = closedReason(db.settings, assignment);
  if (closed) return { ok: false, error: closed };

  var current = findSignup(db, me.email, assignment.id);
  if (current) {
    deleteSignup(me.email, assignment.id);
    appendLog(me.email, assignment.id, 'leave', current.groupId, '');
  }

  return publicState(loadDb(), me);
}

function actionExport(req) {
  var db = loadDb();
  var adminKey = String(db.settings.ADMIN_KEY || '');
  if (!adminKey) return { ok: false, error: 'ADMIN_KEY is not set in the Settings sheet.' };
  if (String(req.adminKey || '') !== adminKey) return { ok: false, error: 'Wrong admin key.' };

  var rows = exportRows(db);
  var out = publicState(db, null);
  out.rows = rows;
  out.csv = toCsv(rows);
  return out;
}

// ---------------------------------------------------------------------------
// Data model
// ---------------------------------------------------------------------------

function loadDb() {
  var course = readKeyValues(SHEETS.COURSE, DEFAULT_COURSE);
  var settings = readKeyValues(SHEETS.SETTINGS, DEFAULT_SETTINGS);
  var ss = SpreadsheetApp.getActiveSpreadsheet();

  var assignments = readRows(SHEETS.ASSIGNMENTS).map(function (r) {
    var id = String(r[0] || '').trim();
    var openCell = String(r[4] == null ? '' : r[4]).trim();
    return {
      id: id,
      name: String(r[1] || '').trim() || id,
      due: toIso(r[2]),
      signupCloses: toIso(r[3]),
      open: openCell === '' ? true : isTrue(openCell),
      instructions: String(r[5] || '').trim(),
      groups: []
    };
  }).filter(function (a) {
    return a.id && RESERVED_SHEET_NAMES.indexOf(a.id) < 0;
  });

  assignments.forEach(function (a) {
    var sheet = ss.getSheetByName(a.id);
    if (!sheet) return; // tab not created yet; assignment shows with no groups
    a.groups = sheet.getDataRange().getValues().slice(1).map(function (r) {
      return {
        id: String(r[0] || '').trim(),
        name: String(r[1] || '').trim(),
        slots: parseInt(r[2], 10) || 0,
        description: String(r[3] || '').trim()
      };
    }).filter(function (g) { return g.id; });
  });

  var roster = readRowsWithPositions(SHEETS.ROSTER).map(function (r, i) {
    return {
      row: i + 2,
      email: normalizeEmail(r[0]),
      name: String(r[1] || '').trim(),
      token: String(r[2] || '').trim()
    };
  }).filter(function (r) { return r.email; });

  var signups = readRows(SHEETS.SIGNUPS).map(function (r) {
    return {
      email: normalizeEmail(r[0]),
      assignment: String(r[1] || '').trim(),
      groupId: String(r[2] || '').trim(),
      updated: r[3]
    };
  }).filter(function (s) { return s.email && s.assignment && s.groupId; });

  return { course: course, settings: settings, assignments: assignments, roster: roster, signups: signups };
}

function readKeyValues(sheetName, defaults) {
  var out = {};
  Object.keys(defaults).forEach(function (k) { out[k] = defaults[k]; });
  readRows(sheetName).forEach(function (r) {
    var key = String(r[0] || '').trim();
    if (key) out[key] = r[1] instanceof Date ? r[1].toISOString() : String(r[1] == null ? '' : r[1]).trim();
  });
  return out;
}

function readRows(name) {
  var values = getSheet(name).getDataRange().getValues();
  return values.slice(1).filter(function (r) {
    return r.some(function (c) { return c !== '' && c !== null && c !== undefined; });
  });
}

/** Like readRows but keeps blank rows so each row's position in the sheet is known. */
function readRowsWithPositions(name) {
  return getSheet(name).getDataRange().getValues().slice(1);
}

function getSheet(name) {
  var sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(name);
  if (!sheet) throw new Error('Sheet "' + name + '" is missing. Run setup() first.');
  return sheet;
}

function findByToken(db, token) {
  token = String(token || '').trim();
  if (!token) return null;
  return db.roster.filter(function (r) { return r.token && r.token === token; })[0] || null;
}

function findAssignment(db, id) {
  id = String(id || '').trim();
  return db.assignments.filter(function (a) { return a.id === id; })[0] || null;
}

function findSignup(db, email, assignmentId) {
  return db.signups.filter(function (s) { return s.email === email && s.assignment === assignmentId; })[0] || null;
}

function upsertSignup(email, assignmentId, groupId) {
  var sheet = getSheet(SHEETS.SIGNUPS);
  var values = sheet.getDataRange().getValues();
  for (var i = 1; i < values.length; i++) {
    if (normalizeEmail(values[i][0]) === email && String(values[i][1] || '').trim() === assignmentId) {
      sheet.getRange(i + 1, 1, 1, 4).setValues([[email, assignmentId, groupId, new Date()]]);
      return;
    }
  }
  sheet.appendRow([email, assignmentId, groupId, new Date()]);
}

function deleteSignup(email, assignmentId) {
  var sheet = getSheet(SHEETS.SIGNUPS);
  var values = sheet.getDataRange().getValues();
  for (var i = values.length - 1; i >= 1; i--) {
    if (normalizeEmail(values[i][0]) === email && String(values[i][1] || '').trim() === assignmentId) sheet.deleteRow(i + 1);
  }
}

function appendLog(email, assignmentId, action, groupId, detail) {
  getSheet(SHEETS.LOG).appendRow([new Date(), email, assignmentId || '', action, groupId || '', detail || '']);
}

// ---------------------------------------------------------------------------
// Public (student-facing) projections — never expose emails or tokens here
// ---------------------------------------------------------------------------

function publicState(db, me) {
  return {
    ok: true,
    course: publicCourse(db),
    settings: publicSettings(db),
    assignments: publicAssignments(db),
    me: me ? publicMe(db, me) : null
  };
}

function publicCourse(db) {
  var c = db.course;
  return {
    name: c.COURSE_NAME, code: c.COURSE_CODE, year: c.YEAR, term: c.TERM, section: c.SECTION, professor: c.PROFESSOR
  };
}

function publicSettings(db) {
  var s = db.settings;
  return {
    signupOpen: isTrue(s.SIGNUP_OPEN),
    openEnrollment: isTrue(s.OPEN_ENROLLMENT),
    selfServiceLinks: isTrue(s.SELF_SERVICE_LINKS)
  };
}

function publicAssignments(db) {
  var nameByEmail = {};
  db.roster.forEach(function (r) { nameByEmail[r.email] = r.name; });
  var display = db.settings.NAME_DISPLAY;

  return db.assignments.map(function (a) {
    var reason = closedReason(db.settings, a);
    return {
      id: a.id,
      name: a.name,
      due: a.due,
      signupCloses: a.signupCloses,
      instructions: a.instructions,
      signupOpen: !reason,
      closedReason: reason,
      groups: a.groups.map(function (g) {
        var members = db.signups
          .filter(function (s) { return s.assignment === a.id && s.groupId === g.id; })
          .map(function (s) { return displayName(nameByEmail[s.email] || s.email.split('@')[0], display); })
          .sort();
        return { id: g.id, name: g.name, slots: g.slots, description: g.description, filled: members.length, members: members };
      })
    };
  });
}

function publicMe(db, me) {
  var selections = {};
  db.signups.forEach(function (s) { if (s.email === me.email) selections[s.assignment] = s.groupId; });
  return { email: me.email, name: me.name, selections: selections };
}

function displayName(name, mode) {
  name = String(name || '').trim();
  if (mode !== 'initial') return name;
  var parts = name.split(/\s+/);
  if (parts.length < 2) return name;
  return parts[0] + ' ' + parts[parts.length - 1].charAt(0).toUpperCase() + '.';
}

function closedReason(settings, assignment) {
  if (!isTrue(settings.SIGNUP_OPEN)) return 'Signup is currently closed for all assignments.';
  if (!assignment.open) return 'Signup for this assignment is closed.';
  if (assignment.signupCloses) {
    var closes = new Date(assignment.signupCloses);
    if (!isNaN(closes.getTime()) && new Date() > closes) return 'The signup deadline for this assignment has passed.';
  }
  return '';
}

// ---------------------------------------------------------------------------
// Export (instructor only) — long format: one row per student per assignment
// ---------------------------------------------------------------------------

function exportRows(db) {
  var rows = [['email', 'name', 'assignment_id', 'assignment_name', 'group_id', 'group_name', 'updated']];
  db.roster.forEach(function (r) {
    db.assignments.forEach(function (a) {
      var s = findSignup(db, r.email, a.id);
      var g = s ? a.groups.filter(function (x) { return x.id === s.groupId; })[0] : null;
      rows.push([
        r.email,
        r.name,
        a.id,
        a.name,
        s ? s.groupId : '',
        g ? g.name : (s ? '(deleted group ' + s.groupId + ')' : ''),
        s && s.updated ? formatDate(s.updated) : ''
      ]);
    });
  });
  return rows;
}

function toCsv(rows) {
  return rows.map(function (r) {
    return r.map(function (c) {
      var v = String(c == null ? '' : c);
      return /[",\n]/.test(v) ? '"' + v.replace(/"/g, '""') + '"' : v;
    }).join(',');
  }).join('\n');
}

function formatDate(d) {
  if (!(d instanceof Date)) return String(d);
  return Utilities.formatDate(d, Session.getScriptTimeZone(), 'yyyy-MM-dd HH:mm');
}

// ---------------------------------------------------------------------------
// Instructor utilities — run these from the Apps Script editor
// ---------------------------------------------------------------------------

/** Create all sheets with headers, a sample assignment, and defaults. Safe to re-run. */
function setup() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  ensureSheet(ss, SHEETS.COURSE, ['key', 'value'],
    Object.keys(DEFAULT_COURSE).map(function (k) { return [k, DEFAULT_COURSE[k]]; }));
  ensureSheet(ss, SHEETS.SETTINGS, ['key', 'value'],
    Object.keys(DEFAULT_SETTINGS).map(function (k) {
      return [k, k === 'ADMIN_KEY' ? newToken() : DEFAULT_SETTINGS[k]];
    }));
  ensureSheet(ss, SHEETS.ASSIGNMENTS, ASSIGNMENT_HEADERS, [
    ['a1', 'Assignment 1 — Example', '2026-10-31', '2026-10-24T23:59', 'true',
     'Choose a group below. Each group will present on a different topic; see the course outline for details.']
  ]);
  ensureSheet(ss, SHEETS.ROSTER, ['email', 'name', 'token', 'created', 'invite_link'], []);
  ensureSheet(ss, SHEETS.SIGNUPS, ['email', 'assignment', 'group_id', 'updated'], []);
  ensureSheet(ss, SHEETS.LOG, ['timestamp', 'email', 'assignment', 'action', 'group_id', 'detail'], []);
  addAssignmentSheets();
  var first = ss.getSheets()[0];
  if (first.getName() === 'Sheet1' && first.getLastRow() === 0) ss.deleteSheet(first);
}

/** For every row in Assignments, create the groups tab (named by the id) if it does not exist yet. */
function addAssignmentSheets() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  readRows(SHEETS.ASSIGNMENTS).forEach(function (r) {
    var id = String(r[0] || '').trim();
    if (!id) return;
    if (RESERVED_SHEET_NAMES.indexOf(id) >= 0) throw new Error('"' + id + '" cannot be used as an assignment id.');
    ensureSheet(ss, id, GROUP_HEADERS, [
      ['A', 'Group A', 4, 'Example group — edit or delete this row'],
      ['B', 'Group B', 4, ''],
      ['C', 'Group C', 4, '']
    ]);
  });
}

function ensureSheet(ss, name, headers, sampleRows) {
  var sheet = ss.getSheetByName(name);
  if (sheet) return sheet;
  sheet = ss.insertSheet(name);
  sheet.getRange(1, 1, 1, headers.length).setValues([headers]).setFontWeight('bold');
  if (sampleRows.length) sheet.getRange(2, 1, sampleRows.length, headers.length).setValues(sampleRows);
  sheet.setFrozenRows(1);
  return sheet;
}

/** Give every Roster row without a token a fresh one. */
function generateTokens() {
  var sheet = getSheet(SHEETS.ROSTER);
  var values = sheet.getDataRange().getValues();
  var count = 0;
  for (var i = 1; i < values.length; i++) {
    if (normalizeEmail(values[i][0]) && !String(values[i][2] || '').trim()) {
      sheet.getRange(i + 1, 3).setValue(newToken());
      if (!values[i][3]) sheet.getRange(i + 1, 4).setValue(new Date());
      count++;
    }
  }
  Logger.log('Generated ' + count + ' token(s).');
}

/** Fill the invite_link column: SITE_URL + "&t=" + token (SITE_URL should already contain ?c=<course key>). */
function writeInviteLinks() {
  var db = loadDb();
  var base = String(db.settings.SITE_URL || '').trim();
  if (!base) throw new Error('Set SITE_URL in the Settings sheet first (your GitHub Pages URL, including ?c=<course key>).');
  var sheet = getSheet(SHEETS.ROSTER);
  var values = sheet.getDataRange().getValues();
  for (var i = 1; i < values.length; i++) {
    var token = String(values[i][2] || '').trim();
    if (normalizeEmail(values[i][0]) && token) {
      sheet.getRange(i + 1, 5).setValue(base + (base.indexOf('?') >= 0 ? '&' : '?') + 't=' + token);
    }
  }
}

/** Email every student on the Roster their personal link (uses the Google account that owns this script). */
function sendInvites() {
  var db = loadDb();
  writeInviteLinks();
  db = loadDb();
  db.roster.forEach(function (r) {
    if (r.token) sendLinkEmail(db, r);
  });
}

function inviteLink(db, token) {
  var base = String(db.settings.SITE_URL || '').trim();
  return base + (base.indexOf('?') >= 0 ? '&' : '?') + 't=' + token;
}

function sendLinkEmail(db, entry) {
  var title = db.course.COURSE_CODE + ' ' + db.course.COURSE_NAME;
  var link = inviteLink(db, entry.token);
  MailApp.sendEmail({
    to: entry.email,
    subject: title + ': your group signup link',
    htmlBody: '<p>Hi ' + escapeHtml(entry.name) + ',</p>' +
      '<p>Use this personal link to choose your groups for ' + escapeHtml(title) + ':</p>' +
      '<p><a href="' + link + '">' + link + '</a></p>' +
      '<p>It signs you in on whichever device you open it on. Please do not share it — it identifies you.</p>' +
      '<p>If you did not request this, you can ignore it.</p>'
  });
}

/** Returns an error message if this student has asked for too many links, else ''. */
function linkRequestLimit(email) {
  var now = Date.now();
  var dayAgo = now - 24 * 60 * 60 * 1000;
  var recent = readRows(SHEETS.LOG).filter(function (r) {
    return normalizeEmail(r[1]) === email && String(r[3]) === 'sendlink' && r[0] instanceof Date && r[0].getTime() > dayAgo;
  });
  if (recent.length >= LINK_REQUESTS_PER_DAY) return 'Too many link requests today. Check your spam folder, or ask the instructor.';
  var latest = recent.reduce(function (m, r) { return Math.max(m, r[0].getTime()); }, 0);
  if (now - latest < LINK_REQUEST_COOLDOWN_MS) return 'A link was sent a moment ago. Check your inbox and spam folder before trying again.';
  return '';
}

/** Optional: upload a CSV snapshot of the signups to Dropbox. See README for the one-time OAuth setup. */
function backupToDropbox() {
  var props = PropertiesService.getScriptProperties();
  var appKey = props.getProperty('DROPBOX_APP_KEY');
  var appSecret = props.getProperty('DROPBOX_APP_SECRET');
  var refreshToken = props.getProperty('DROPBOX_REFRESH_TOKEN');
  var db = loadDb();
  var defaultPath = '/group-signup/' + String(db.course.COURSE_CODE || 'course').replace(/[^\w\-]+/g, '_') + '_signups.csv';
  var path = props.getProperty('DROPBOX_PATH') || defaultPath;
  if (!appKey || !refreshToken) throw new Error('Set DROPBOX_APP_KEY and DROPBOX_REFRESH_TOKEN in Script Properties.');

  var tokenResp = UrlFetchApp.fetch('https://api.dropboxapi.com/oauth2/token', {
    method: 'post',
    payload: { grant_type: 'refresh_token', refresh_token: refreshToken, client_id: appKey, client_secret: appSecret || '' }
  });
  var accessToken = JSON.parse(tokenResp.getContentText()).access_token;

  var csv = toCsv(exportRows(db));
  UrlFetchApp.fetch('https://content.dropboxapi.com/2/files/upload', {
    method: 'post',
    contentType: 'application/octet-stream',
    headers: {
      Authorization: 'Bearer ' + accessToken,
      'Dropbox-API-Arg': JSON.stringify({ path: path, mode: 'overwrite', mute: true })
    },
    payload: csv
  });
  Logger.log('Uploaded ' + csv.length + ' bytes to Dropbox at ' + path);
}

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

function normalizeEmail(v) {
  return String(v || '').trim().toLowerCase();
}

function isTrue(v) {
  return /^(true|yes|1|on)$/i.test(String(v || '').trim());
}

function toIso(v) {
  if (v instanceof Date) return isNaN(v.getTime()) ? '' : v.toISOString();
  return String(v == null ? '' : v).trim();
}

function newToken() {
  return Utilities.getUuid().replace(/-/g, '');
}

/** Opaque, stable id for a roster entry (first 12 hex chars of SHA-256 of the email). */
function rosterId(email) {
  var bytes = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, email, Utilities.Charset.UTF_8);
  return bytes.slice(0, 6).map(function (b) {
    var h = (b < 0 ? b + 256 : b).toString(16);
    return h.length < 2 ? '0' + h : h;
  }).join('');
}

function maskEmail(email) {
  var at = email.indexOf('@');
  if (at < 1) return '***';
  return email.charAt(0) + '***' + email.slice(at);
}

function escapeHtml(s) {
  return s.replace(/[&<>"']/g, function (c) {
    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
  });
}
